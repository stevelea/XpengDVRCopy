[Unit]
Description=Archive car-camera USB ($1) to the NAS share
After=network-online.target remote-fs.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
# RemainAfterExit must NOT be set. With it, the unit stays "active (exited)"
# after the first copy, so systemd considers a later start request already
# satisfied and the second insertion silently does nothing. Leaving it unset
# returns the unit to inactive, which is what lets udev start it again.
# Wait for a DHCP address before trying to reach the NAS.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do ip route | grep -q "^default" && exit 0; sleep 2; done; exit 0'
ExecStart=/usr/local/bin/copyusb.sh /dev/%I
# No ExecStopPost marking the MQTT entities offline here. This unit stops at the
# same instant it publishes "safe", so doing that made Home Assistant show
# "unavailable" instead of the status you were waiting for. Availability is owned
# by xpg-mqtt-avail.service, which stays up.
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
